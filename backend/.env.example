# Local development template. Copy to backend/.env and fill in real values.
# Never commit backend/.env or place production secrets in source control.

# Neon PostgreSQL connection URL. Copy from Neon Console > Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Exact origin of the deployed frontend (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173

# Used to sign JWTs for authenticated sessions — generate a long random
# string for this, never reuse the example value.
JWT_SECRET=change-me-to-a-long-random-string

# Nylas Transactional Send. NYLAS_DOMAIN must be registered and verified in Nylas.
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_DOMAIN=coursehubs.nylas.email

# Purpose-specific sender identities. Both addresses must use NYLAS_DOMAIN.
NYLAS_VERIFY_FROM_EMAIL=verify@coursehubs.nylas.email
NYLAS_VERIFY_FROM_NAME=CourseHubs Verification
NYLAS_PASSWORD_RESET_FROM_EMAIL=password-reset@coursehubs.nylas.email
NYLAS_PASSWORD_RESET_FROM_NAME=CourseHubs Security

# Firebase Cloud Storage — same as above, filled in once file upload
# work begins.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

