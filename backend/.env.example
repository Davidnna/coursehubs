# Copy this file to ".env" (same folder) and fill in real values.
# Note: some free PHP hosts (e.g. InfinityFree) hide dotfiles in their
# web-based file manager, which can make .env hard to find after
# uploading — use an FTP/SFTP client if that happens, or look for a
# "show hidden files" toggle. This file lives outside public/, so it's
# never web-accessible regardless.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=coursehub
DB_USER=root
DB_PASS=

# Origin of the deployed frontend (React app). Use * only for local dev.
FRONTEND_ORIGIN=http://localhost:5173

# Used to sign JWTs for authenticated sessions — generate a long random
# string for this, never reuse the example value.
JWT_SECRET=change-me-to-a-long-random-string

# Brevo (email) — leave blank during early development; endpoints that
# need it will simply skip sending until a real key is set.
BREVO_API_KEY=

# Firebase Cloud Storage — same as above, filled in once file upload
# work begins.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
