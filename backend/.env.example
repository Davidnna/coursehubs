# Local development template. Copy to backend/.env and fill in real values.
# Never commit backend/.env or place production secrets in source control.

# Neon PostgreSQL connection URL. Copy from Neon Console > Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Exact origin of the deployed frontend (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173

# Used to sign JWTs for authenticated sessions — generate a long random
# string for this, never reuse the example value.
JWT_SECRET=change-me-to-a-long-random-string

# Brevo transactional email. MAIL_FROM must be a verified sender in Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=CourseHubs

# Firebase Cloud Storage — same as above, filled in once file upload
# work begins.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

