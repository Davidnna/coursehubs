# PostgreSQL / Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Frontend origin used for CORS and transactional email links
FRONTEND_ORIGIN=http://localhost:5173

# Generate a long random secret (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Only these reverse proxies may supply client IP forwarding headers.
# The local loopback proxy addresses are trusted by default; add other ranges only when documented by the hosting provider.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Optional one-time bootstrap: exact email of an existing verified account.
# After deployment promotes this account to the first super administrator, remove this variable.
INITIAL_SUPER_ADMIN_EMAIL=

# Nylas transactional email
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_DOMAIN=your-registered-domain.nylas.email
NYLAS_VERIFY_FROM_EMAIL=verify@your-registered-domain.nylas.email
NYLAS_VERIFY_FROM_NAME=CourseHubs Verification
NYLAS_PASSWORD_RESET_FROM_EMAIL=password-reset@your-registered-domain.nylas.email
NYLAS_PASSWORD_RESET_FROM_NAME=CourseHubs Security
NYLAS_SUPPORT_EMAIL=support@your-registered-domain.nylas.email

# Google OAuth (create a Web application OAuth client in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Private Neon Object Storage (S3-compatible) for academic resources
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=coursehubs-resources
